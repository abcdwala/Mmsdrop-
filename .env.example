# DropMms Pro Client Configuration (injected into BuildConfig via Secrets Gradle Plugin).
# Configure actual values in the Secrets panel in AI Studio (never commit .env).
# Note: Never place SUPABASE_SERVICE_ROLE_KEY or TELEGRAM_BOT_TOKEN here — those stay strictly on the Supabase Edge Function server.

SUPABASE_URL=MY_SUPABASE_URL
SUPABASE_ANON_KEY=MY_SUPABASE_ANON_KEY
TELEGRAM_BOT_USERNAME=MY_TELEGRAM_BOT_USERNAME
