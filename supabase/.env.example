# Server-side Supabase Edge Function Secrets (NEVER bundle into the Android APK or WebApp)
# Note: Supabase Edge Functions automatically inject SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# In Supabase Dashboard -> Edge Functions -> Secrets, add:

DROPMMS_JWT_SECRET=YOUR_SUPABASE_LEGACY_JWT_SECRET
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
OWNER_TELEGRAM_ID=8254788387
